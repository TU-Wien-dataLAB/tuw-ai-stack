{{- define "matrix.payload" -}}
{{- $status := .Status -}}
{{- $severity := .CommonLabels.severity -}}
{{- $emoji := "⚠️" -}}
{{- $resolved := "" -}}
{{- if eq $severity "critical" }}{{ $emoji = "🚨" }}{{ end -}}
{{- if eq $status "resolved" }}{{ $emoji = "✅" }}{{ $resolved = " (resolved)" }}{{ end -}}
{{- $alertname := .CommonLabels.alertname -}}
{{- $namespace := .CommonLabels.namespace -}}
{{- $summary := .CommonAnnotations.summary -}}
{{- $description := .CommonAnnotations.description -}}
{{- $runbookURL := .CommonAnnotations.runbook_url -}}
{{- $alerts := .Alerts -}}
{{- $alertCount := len $alerts -}}
<h3>{{ $emoji }} {{ $alertname }}{{ $resolved }}</h3>
<p><b>{{ $summary }}</b></p>
<p>
<b>Alert Count:</b> {{ $alertCount }}<br>
<b>Namespace:</b> {{ $namespace }}<br>
<b>Description:</b> {{ $description }}<br>
{{- if $runbookURL }}
<b>Runbook:</b> <a href="{{ $runbookURL }}">View Runbook</a><br>
{{- end }}
</p>
{{- if gt $alertCount 1 }}
<p><b>Individual Alerts:</b></p>
<ul>
{{- range $alerts }}
<li>{{ .Labels.instance }} - {{ .Annotations.summary }}</li>
{{- end }}
</ul>
{{- end }}
{{- end -}}