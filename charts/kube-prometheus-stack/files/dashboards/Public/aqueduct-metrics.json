        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(aqueduct_model_concurrency_limit{namespace=\"$namespace\"}, model)",
          "refId": "model"
        },
        "definition": "label_values(aqueduct_model_concurrency_limit{namespace=\"$namespace\"}, model)",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "options": []
