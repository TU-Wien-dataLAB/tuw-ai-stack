        "query": {
          "query": "label_values(aqueduct_build_info, namespace)",
          "refId": "ns"
        },
        "definition": "label_values(aqueduct_build_info, namespace)",
        "current": {
          "text": "aqueduct",
          "value": "aqueduct"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "options": []
      },
      {
        "name": "model",
